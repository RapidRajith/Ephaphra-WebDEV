# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/third-lane"
MONGODB_URI="mongodb://localhost:27017/third-lane"

# Email Service Configuration
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@thirdlanepodcast.com"
SENDGRID_API_KEY="your-sendgrid-key"

# YouTube API Configuration
NEXT_PUBLIC_YOUTUBE_API_KEY="your-youtube-api-key"
NEXT_PUBLIC_PLAYLIST_ID="your-playlist-id"

# Application URLs
NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Analytics
NEXT_PUBLIC_GA_ID="your-google-analytics-id"

# Feature Flags
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_COMMENTS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
